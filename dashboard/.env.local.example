# Copy this file to .env.local and fill with your Supabase project values
# For local dev you can use either the public NEXT_PUBLIC_* names or the server names.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Alternatively (used by some examples in this repo):
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
